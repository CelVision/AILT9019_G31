[Unit]
Description=ConnectFour Connect FastAPI ASGI Application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/AILT9019_G31/server
Environment="PATH=/var/www/AILT9019_G31/server/venv/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
# Keep secrets outside the repository. Create this file with:
#   sudo install -m 640 -o root -g www-data /dev/null /etc/connectfour/connectfour.env
# and add GLM_API_KEY=... (never commit the real key).
EnvironmentFile=-/etc/connectfour/connectfour.env
# Single worker is required: matchmaking queues and rooms live in this process's RAM.
# Multiple workers would put players in separate, invisible matchmaking pools.
ExecStart=/var/www/AILT9019_G31/server/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers

Restart=always
RestartSec=3
LimitNOFILE=65536

# No pre-created log directory is needed. Inspect with journalctl -u connectfour.
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
