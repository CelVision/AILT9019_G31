# Copy to server/.env for local development. NEVER commit the real .env.
# The server reads these values from the environment; the browser never sees them.

# GLM / Zhipu AI key (server-side only).
GLM_API_KEY=

# Zhipu mainland:
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Z.ai international alternative:
# GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Default model shown in the client and used when the player does not choose one.
GLM_MODEL=glm-4-flash

# Comma-separated allowlist. The server must reject any model not listed here.
GLM_ALLOWED_MODELS=glm-4-flash

# Per-move LLM deadline in seconds. Live smoke measured ~1.74s, so 1.5s is
# too tight. 2.5s matches the proposal; the technical spec still says 1.5s.
AI_TIMEOUT_SECONDS=2.5
