# Copy to server/.env for local development. NEVER commit the real .env.
# The server reads these values from the environment; the browser never sees them.

# Alibaba Cloud Bailian (Model Studio) key (server-side only).
AI_API_KEY=

# Group 31 sponsored Bailian OpenAI-compatible endpoint.
AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Default model used for PvE moves and AI Coach chat.
AI_MODEL=qwen3.6-flash

# Comma-separated allowlist. The server must reject any model not listed here.
# The client does not currently expose model selection.
AI_ALLOWED_MODELS=qwen3.6-flash

# Per-request AI deadline in seconds. Live Qwen3.6-Flash move probes returned
# legal columns in roughly 1.4–3.9s; 3.5s keeps turns responsive.
AI_TIMEOUT_SECONDS=3.5

# Compatibility: the server still reads the older GLM_API_KEY, GLM_BASE_URL,
# GLM_MODEL, and GLM_ALLOWED_MODELS names when the AI_* values are unset.
